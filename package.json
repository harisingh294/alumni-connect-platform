{
  "name": "alumni-connect-platform",
  "version": "1.0.0",
  "description": "B2B SaaS platform for educational institutions to maintain verified alumni networks and empower students through structured mentorship.",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "seed": "node server/seed-cli.js",
    "seed:sandbox": "node server/seed-cli.js --sandbox",
    "backup": "node server/backup.js",
    "migrate": "node server/db/migrate.js",
    "test": "node --import ./tests/preload.js --test tests/**/*.test.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "alumni",
    "mentorship",
    "saas",
    "edtech"
  ],
  "author": "Alumni Connect Platform Team",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1"
  }
}
